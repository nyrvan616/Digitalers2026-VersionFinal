 <project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>Edit</groupId>
  <artifactId>Digitalers2026</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>Digitalers 2026</name>
  
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <selenium.version>4.48.0</selenium.version>
    <junit.version>6.1.3</junit.version>
  </properties> 
   
  <dependencies>
  	<dependency>
	  <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    
    <dependency>
    	<groupId>org.testng</groupId>
	    <artifactId>testng</artifactId>
	    <version>7.12.0</version>
	    <scope>test</scope>
    </dependency>

	<dependency>
		<groupId>commons-io</groupId>
		<artifactId>commons-io</artifactId>
		<version>2.21.0</version>
	</dependency>

	<dependency>
	    <groupId>org.apache.poi</groupId>
	    <artifactId>poi-ooxml</artifactId>
	    <version>5.5.1</version>
	    <scope>test</scope>
    </dependency>
    
    <dependency>
    	<groupId>com.mysql</groupId>
	    <artifactId>mysql-connector-j</artifactId>
	    <version>26.7.0</version>
	    <scope>test</scope>
	</dependency>
</dependencies>

<!-- Para Ejecutar los tests Por Consola -->
<build>
    <plugins>
    	<!-- Este Plugin servirá de traductor de archivos esritos en JAVA 
    	a archivos ejecutables .class que nuestra computadora podrá entender-->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.16.0</version>
            <configuration>
                <release>25</release>
            </configuration>
        </plugin>
        <!-- Este Plugin se encargara de buscar, arrancar y ejecutar los tests -->       
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.6.0</version>
        </plugin>
    </plugins>
</build> 
</project>